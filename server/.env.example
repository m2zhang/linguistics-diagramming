# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string for the local dev database.
# Matches the setup steps in the plan: user/db "syntaxtree_dev", password "devpassword".
DATABASE_URL=postgres://syntaxtree_dev:devpassword@localhost:5432/syntaxtree_dev

# Random 32+ byte secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret

# Port the Express API listens on. The Vite dev server proxies /api here.
# Named API_PORT (not PORT) on purpose — some dev tooling sets its own PORT
# env var, which would otherwise silently win over this file's value.
API_PORT=4000

# "development" disables the "secure" cookie flag (needed for plain http://localhost).
NODE_ENV=development
