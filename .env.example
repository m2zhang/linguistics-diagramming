# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings -> API. Only VITE_-prefixed vars reach the browser, and both
# of these are designed to be public — row level security is what protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
