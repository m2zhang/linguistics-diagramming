# Supabase — copy this file to `.env.local` and fill in your project's values.
# Find them in the Supabase dashboard under Project Settings → API.
# Only VITE_-prefixed vars are exposed to the client (the anon key is safe to ship).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
