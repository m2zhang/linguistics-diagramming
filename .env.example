# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings -> API. Only VITE_-prefixed vars reach the browser, and both
# of these are designed to be public — row level security is what protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Where the app is served from. Leave unset for the domain root and for local
# development. Set it at BUILD time when deploying under a subpath, e.g. a UTSC
# user directory — include both the leading and the trailing slash:
#
#   VITE_BASE_PATH=/~you/syntaxtree/
#
# It drives the asset base, the router basename, and the Supabase OAuth and
# password-reset redirect URLs together, so these cannot drift apart. Whatever
# you set here, add "<origin><VITE_BASE_PATH>*" to the Supabase dashboard under
# Authentication -> URL Configuration -> Redirect URLs, or the provider will
# refuse the round trip.
# VITE_BASE_PATH=/
